# Apptainer recipe for 3DGEER on the MODUS HPC. Built ON MODUS, as a CPU-node
# job, with:   cd <repo> && sbatch hpc/build_sif.slurm
#
# A step-for-step translation of docker/Dockerfile_5090, which stays the recipe
# for the dev PC. Keep the two in step: a dependency change in one belongs in
# the other. Deltas from Dockerfile_5090, and only these:
#   1. ARCH_LIST "8.9;9.0+PTX" instead of "12.0+PTX": MODUS has an RTX 6000 Ada
#      (sm_89, modus-visu) and H200 NVL (sm_90, gpu01). PTX is forward-only, so
#      a 12.0 build cannot run on either. +PTX on 9.0 covers newer GPUs.
#   2. ninja, so the in-place extension rebuilds on gpu01 (hpc/build_extensions.sh)
#      are fast.
#   3. PYTHONNOUSERSITE=1 at runtime: Apptainer bind-mounts $HOME, so
#      ~/.local/lib/python3.11 would otherwise shadow the image's site-packages.
#   4. The copied geer-rasterizer is cleaned of build/ and *.so before install.
#      On MODUS the repo's copy has been built in place for sm_90 only, and
#      setuptools would reuse those objects instead of compiling for ARCH_LIST.
#   5. The SIBR_* and baseline paths that init_my_docker.sh passes with --env
#      are set in %environment instead.
#   6. SIBR comes from the fork github.com/fellowchrononaut/SIBR-Core-EXECO at
#      329bfcb instead of gitlab sibr_core at d8856f6. The fork is d8856f6 plus
#      the four CMake fixes Dockerfile_5090 applies with sed/mv (032a6c5), plus
#      the show_normals toggle in the remote viewer (329bfcb) that
#      network_gui.py / train.py / visualizer.py expect. So those sed/mv steps
#      are dropped here: the fork already contains them.
#
# Verified on MODUS 2026-10-15: --fakeroot works without root (no /etc/subuid
# entry needed), Docker Hub / gitlab.inria.fr / PyPI are reachable after
# `module load proxy`, including from CPU nodes, and APPTAINER_TMPDIR on GPFS works.
#
# %files paths are relative to the directory `apptainer build` runs in, so it
# must run from the repo root (hpc/build_sif.slurm does this).

Bootstrap: docker
From: pytorch/pytorch:2.7.0-cuda12.8-cudnn9-devel

%arguments
    ARCH_LIST=8.9;9.0+PTX
    JOBS=16

%files
    submodules/geer-rasterizer /workspace/3dgs_dependency/geer-rasterizer

%environment
    export PYTHONNOUSERSITE=1
    export sibr_rg=/workspace/3dgs_dependency/sibr_core/install/bin/SIBR_remoteGaussian_app
    export sibr_gv=/workspace/3dgs_dependency/sibr_core/install/bin/SIBR_gaussianViewer_app

%post
    set -e
    # Docker ENV from the base image is not guaranteed to be active in %post.
    export PATH=/opt/conda/bin:/usr/local/cuda/bin:$PATH
    export CUDA_HOME=/usr/local/cuda
    export TORCH_CUDA_ARCH_LIST="{{ ARCH_LIST }}"
    export MAX_JOBS={{ JOBS }}
    export DEBIAN_FRONTEND=noninteractive

    # Update and install tzdata separately
    apt update && apt install -y tzdata

    # Install necessary packages
    apt install -y git && \
        apt install -y libglew-dev libassimp-dev libboost-all-dev libgtk-3-dev libopencv-dev libglfw3-dev libavdevice-dev libavcodec-dev libeigen3-dev libxxf86vm-dev libembree-dev && \
        apt clean && apt install wget && rm -rf /var/lib/apt/lists/*

    # Clone the repository (dev branch): https://github.com/graphdeco-inria/gaussian-splatting/issues/965
    mkdir -p /workspace/3dgs_dependency && cd /workspace/3dgs_dependency
    git clone https://github.com/fellowchrononaut/SIBR-Core-EXECO.git sibr_core \
        && git clone https://gitlab.inria.fr/bkerbl/simple-knn.git

    cd /workspace/3dgs_dependency/sibr_core && git reset --hard 329bfcb
    cd /workspace/3dgs_dependency/simple-knn && git reset --hard 44f7642
    # CUDA 12.8+ no longer transitively includes <float.h>; simple-knn references FLT_MAX without an explicit include.
    sed -i '1i #include <cfloat>' simple_knn.cu

    # Delta 4: drop artifacts of in-place builds that came along with the copy.
    cd /workspace/3dgs_dependency/geer-rasterizer
    rm -rf build dist *.egg-info && find . -name '*.so' -delete

    cd /workspace
    pip install --upgrade pip && \
        pip install tqdm plyfile==1.1 opencv-python==4.10.0.84 psutil matplotlib numpy==1.26.4 ninja && \
        pip install --no-build-isolation ./3dgs_dependency/simple-knn && \
        pip install --no-build-isolation ./3dgs_dependency/geer-rasterizer

    # The OpenCV/Embree CMake tweaks Dockerfile_5090 applies here are already
    # committed in SIBR-Core-EXECO (032a6c5); see delta 6.

    # Ready to build the viewer now.
    cd /workspace/3dgs_dependency/sibr_core
    cmake -Bbuild . -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 && \
        cmake --build build -j{{ JOBS }} --target install

%labels
    Description 3DGEER for MODUS (sm_89 + sm_90), see hpc/README.md
